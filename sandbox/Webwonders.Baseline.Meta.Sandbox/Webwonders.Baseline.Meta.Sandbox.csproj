<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Local test site for the package. It lives outside /src and is not part of the .sln,
    so the publish pipeline (src/**/Webwonders.Baseline.*.csproj) never builds it.
    See sandbox/README.md for how to run it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.*" />
    <ProjectReference Include="..\..\src\Webwonders.Baseline.Meta.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Razor compilation of the sandbox site is not needed for testing -->
    <Compile Remove="umbraco\**" />
  </ItemGroup>
</Project>
