{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Cache=Shared;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "00000000-0000-0000-0000-000000000001",
        "SanitizeTinyMce": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Sandbox Admin",
        "UnattendedUserEmail": "admin@sandbox.local",
        "UnattendedUserPassword": "Sandbox1234!"
      },
      "Hosting": {
        "Debug": true
      },
      "Imaging": {
        "HMACSecretKey": "\u002B1qr4sdj/RpBh8C7dxJ96NPZWxc4uotmzlM7xdfvBlpot4wUe\u002B8lfvjMKk4u6CCy\u002B0/AQ9yMW9bgmTgV/TadMg=="
      }
    }
  },
  "Webwonders": {
